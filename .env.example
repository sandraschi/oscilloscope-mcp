# oscilloscope-mcp configuration
# Copy to .env and adjust for your bench.

# Backend selection: auto | simulator | picoscope | hantek
OSCILLOSCOPE_MCP_BACKEND=auto

# Preferred device serial or ID (optional; first match used when empty)
OSCILLOSCOPE_MCP_DEVICE_ID=

# Default capture directory (relative to repo or absolute path)
OSCILLOSCOPE_MCP_CAPTURE_DIR=./captures

# Transport (stdio | http | sse)
OSCILLOSCOPE_MCP_TRANSPORT=stdio
OSCILLOSCOPE_MCP_HOST=127.0.0.1
OSCILLOSCOPE_MCP_PORT=10936
OSCILLOSCOPE_MCP_PATH=/mcp

# Logging (stderr only; never stdout in stdio mode)
OSCILLOSCOPE_MCP_LOG_LEVEL=INFO
OSCILLOSCOPE_ALLOW_LOGGING=0

# PicoScope: PicoSDK must be installed separately from picotech.com
# Hantek: WinUSB/libusb driver via Zadig on Windows; udev rules on Linux
